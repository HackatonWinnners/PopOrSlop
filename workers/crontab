# PopOrSlop worker schedule (install with `crontab -e` on the host that runs
# workers; paths assume the repo at ~/PopOrSlop and the venv at workers/.venv).
# All jobs are idempotent — double-fires and backfills are harmless.

PY=~/PopOrSlop/workers/.venv/bin/python
WORKDIR=~/PopOrSlop/workers

# EDGAR daily indexes are complete by ~06:15 ET; run at 12:45 UTC.
45 12 * * * cd $WORKDIR && $PY -m poporslop_workers.cli edgar_formd >> /tmp/poporslop-workers.log 2>&1

# Matcher after each source window.
0 13 * * * cd $WORKDIR && $PY -m poporslop_workers.cli matcher >> /tmp/poporslop-workers.log 2>&1

# Insolvenz portal 2×/day (its §4 InsoBekV search window is ~2 weeks).
15 6,18 * * * cd $WORKDIR && $PY -m poporslop_workers.cli insolvenz_de >> /tmp/poporslop-workers.log 2>&1

# Companies House 4×/day (needs CH_API_KEY in the environment).
5 */6 * * * cd $WORKDIR && $PY -m poporslop_workers.cli companies_house >> /tmp/poporslop-workers.log 2>&1

# Auto-resolver drafts proposals right after the matcher pass.
10 13 * * * cd $WORKDIR && $PY -m poporslop_workers.cli auto_resolver >> /tmp/poporslop-workers.log 2>&1

# Wayback backfill: small batches hourly (anonymous SPN2 is heavily throttled).
30 * * * * cd $WORKDIR && $PY -m poporslop_workers.cli archive_backfill >> /tmp/poporslop-workers.log 2>&1
